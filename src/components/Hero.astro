---
import site from '../data/site.json';
---

<section id="hero" class="pt-20 pb-16 sm:pt-28 sm:pb-24">
  <img
    src={`${import.meta.env.BASE_URL}photo.jpg`}
    alt={`Portrait de ${site.name}`}
    width="96"
    height="96"
    class="w-20 h-20 sm:w-24 sm:h-24 object-cover border border-border grayscale hover:grayscale-0 transition-[filter] duration-300 mb-6"
  />
  <p class="text-accent text-xs uppercase tracking-widest mb-4">// hello_world</p>
  <h1 class="text-2xl sm:text-4xl font-semibold font-sans text-fg mb-3">
    {site.name}<span class="blink-cursor"></span>
  </h1>
  <p class="text-muted text-sm sm:text-base mb-1">{site.role}</p>
  <p class="text-muted text-xs sm:text-sm mb-8">{site.location}</p>
  <p class="font-sans text-base sm:text-lg leading-relaxed max-w-2xl mb-10 text-fg/90">{site.tagline}</p>
  <div class="flex flex-wrap gap-x-6 gap-y-3 font-mono text-sm">
    <a href={site.links.github} target="_blank" rel="noopener noreferrer" class="link-underline hover:text-accent transition-colors">→ github</a>
    <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer" class="link-underline hover:text-accent transition-colors">→ linkedin</a>
    <a href={`mailto:${site.links.email}`} class="link-underline hover:text-accent transition-colors">→ email</a>
    {site.links.cv && (
      <a href={`${import.meta.env.BASE_URL}${site.links.cv}`} download class="link-underline hover:text-accent transition-colors">→ cv.pdf</a>
    )}
  </div>
</section>
