---
import site from '../data/site.json';
const year = new Date().getFullYear();
---

<footer class="border-t border-border mt-24">
  <div class="max-w-[52rem] mx-auto px-6 py-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 font-mono text-xs text-muted">
    <div class="flex flex-wrap gap-x-4 gap-y-2">
      <a href={`mailto:${site.links.email}`} class="link-underline hover:text-accent transition-colors">{site.links.email}</a>
      <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer" class="link-underline hover:text-accent transition-colors">linkedin</a>
      <a href={site.links.github} target="_blank" rel="noopener noreferrer" class="link-underline hover:text-accent transition-colors">github</a>
    </div>
    <p>© {year} {site.name} · built with Astro + Tailwind</p>
  </div>
</footer>
