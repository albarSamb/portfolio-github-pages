---
import skills from '../data/skills.json';
import SectionHeading from './SectionHeading.astro';
---

<section id="skills" class="py-16 border-t border-border">
  <SectionHeading index="02" kicker="stack" title="Compétences" />
  <div class="space-y-6">
    {skills.map((group) => (
      <div>
        <h3 class="text-xs uppercase tracking-widest text-muted mb-3">{group.category}</h3>
        <div class="flex flex-wrap gap-2">
          {group.items.map((item) => (
            <span class="text-xs font-mono border border-border px-2.5 py-1 text-fg/90 hover:border-accent hover:text-accent transition-colors">
              {item}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
